{
  "manifest_version": 3,
  "name": "WebStream Precision Control",
  "version": "1.0.0",
  "description": "Precision remote control and diagnostics overlay foundation for HomeMonitor WebStream.",
  "icons": {
    "16": "extension/assets/icons/icon16.png",
    "48": "extension/assets/icons/icon48.png",
    "128": "extension/assets/icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_title": "WebStream Precision Control"
  },
  "options_ui": {
    "page": "extension/options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webstream-precision@homemonitor.local",
      "strict_min_version": "109.0"
    }
  }
}
