{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "devices": {
          "$deviceId": {
            ".indexOn": ["lastSeen", "online", "timestamp"],
            "status": {
              ".validate": "newData.hasChildren(['deviceId', 'lastSeen'])"
            },
            "commands": {
              ".indexOn": ["timestamp", "status"]
            },
            "telemetry": {
              ".indexOn": ["timestamp"]
            },
            "webrtc_signaling": {
              "sessions": {
                "$sessionId": {
                  ".indexOn": ["status", "timestamp"]
                }
              }
            }
          }
        }
      }
    }
  }
}
