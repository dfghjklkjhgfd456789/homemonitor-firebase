{
  "name": "homemonitor-web-dashboard",
  "version": "1.4.0",
  "private": true,
  "description": "HomeMonitor Web Dashboard & Security Rules Test Harness",
  "scripts": {
    "test:functional": "node web-dashboard/tests/dashboard-functional.test.js",
    "test:protocol": "node web-dashboard/tests/signaling-protocol.test.js",
    "test:rules": "node web-dashboard/tests/firebase-rules-security.test.js",
    "test:emulator": "npx firebase-tools emulators:exec --only database --project demo-homemonitor \"node web-dashboard/tests/firebase-signaling-emulator.test.js\"",
    "check:syntax": "node --check web-dashboard/js/*.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^15.37.0"
  }
}
